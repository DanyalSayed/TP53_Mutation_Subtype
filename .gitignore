data/processed/
data/splits/

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# COSMIC-derived instance-level / position-level records -- not redistributable
